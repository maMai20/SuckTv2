@import "tailwindcss";
@import "tw-animate-css";

/* Light mode variables */
:root {
  /* Updated color palette for modern minimal design */
  --background: #ffffff;
  --foreground: #4b5563;
  --card: #f9fafb;
  --card-foreground: #4b5563;
  --popover: #ffffff;
  --popover-foreground: #4b5563;
  --primary: #0891b2;
  --primary-foreground: #ffffff;
  --secondary: #dc2626;
  --secondary-foreground: #ffffff;
  --muted: #f9fafb;
  --muted-foreground: #6b7280;
  --accent: #dc2626;
  --accent-foreground: #ffffff;
  --destructive: #dc2626;
  --destructive-foreground: #ffffff;
  --border: #e5e7eb;
  --input: #ffffff;
  --ring: rgba(8, 145, 178, 0.5);
  --chart-1: #0891b2;
  --chart-2: #dc2626;
  --chart-3: #f59e0b;
  --chart-4: #4b5563;
  --chart-5: #f9fafb;
  --radius: 0.75rem;

  /* Sidebar */
  --sidebar: #f9fafb;
  --sidebar-foreground: #4b5563;
  --sidebar-primary: #0891b2;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #dc2626;
  --sidebar-accent-foreground: #ffffff;
  --sidebar-border: #e5e7eb;
  --sidebar-ring: rgba(8, 145, 178, 0.5);
}

/* Dark mode overrides */
.dark {
  --background: #1f2937;
  --foreground: #f9fafb;
  --card: #374151;
  --card-foreground: #f9fafb;
  --popover: #374151;
  --popover-foreground: #f9fafb;
  --primary: #06b6d4;
  --primary-foreground: #ffffff;
  --secondary: #ef4444;
  --secondary-foreground: #ffffff;
  --muted: #374151;
  --muted-foreground: #9ca3af;
  --accent: #ef4444;
  --accent-foreground: #ffffff;
  --destructive: #ef4444;
  --destructive-foreground: #ffffff;
  --border: #4b5563;
  --input: #374151;
  --ring: rgba(6, 182, 212, 0.5);
  --chart-1: #06b6d4;
  --chart-2: #ef4444;
  --chart-3: #f59e0b;
  --chart-4: #9ca3af;
  --chart-5: #374151;

  /* Sidebar */
  --sidebar: #374151;
  --sidebar-foreground: #f9fafb;
  --sidebar-primary: #06b6d4;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #ef4444;
  --sidebar-accent-foreground: #ffffff;
  --sidebar-border: #4b5563;
  --sidebar-ring: rgba(6, 182, 212, 0.5);
}

/* Base layer */
@layer base {
  * {
    border-color: var(--border);
    outline-color: var(--ring);
  }
  body {
    background-color: var(--background);
    color: var(--foreground);
    @apply font-sans;
  }
}
